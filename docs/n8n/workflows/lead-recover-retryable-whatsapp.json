{
  "name": "Lead — Recover retryable WhatsApp (manual)",
  "active": false,
  "settings": {},
  "nodes": [
    {
      "name": "Run WhatsApp recovery manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "name": "Claim one retryable WhatsApp delivery",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidate AS (SELECT w.email_key FROM whatsapp_delivery_state w JOIN lead_processing_state l USING (email_key) WHERE w.status='retryable' AND w.next_retry_at <= now() AND (w.lease_until IS NULL OR w.lease_until < now()) AND l.state='retryable' AND l.stage='whatsapp' ORDER BY w.next_retry_at FOR UPDATE OF w SKIP LOCKED LIMIT 1) UPDATE whatsapp_delivery_state w SET status='pending', next_retry_at=now(), updated_at=now() FROM candidate WHERE w.email_key=candidate.email_key RETURNING w.email_key;",
        "options": {}
      }
    },
    {
      "name": "Resume WhatsApp worker",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "each",
        "workflowId": "<CONFIGURE_WORKFLOW_REFERENCE>",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "emailKey": "={{ $json.email_key }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "emailKey",
              "displayName": "emailKey",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Run WhatsApp recovery manually": {
      "main": [
        [
          {
            "node": "Claim one retryable WhatsApp delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim one retryable WhatsApp delivery": {
      "main": [
        [
          {
            "node": "Resume WhatsApp worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
