                                         "jsonBody":  "={{\n(() =\u003e {\n  return {\n    model: \u0027qwen3.5:9b\u0027,\n    stream: false,\n    think: false,\n    options: { temperature: 0 },\n    format: {\n      type: \u0027object\u0027,\n      properties: {\n        priority: { type: \u0027string\u0027, enum: [\u0027high\u0027, \u0027normal\u0027, \u0027low\u0027] },\n        manualReview: { type: \u0027boolean\u0027 },\n        summary: { type: \u0027string\u0027, minLength: 10, maxLength: 280 },\n      },\n      required: [\u0027priority\u0027, \u0027manualReview\u0027, \u0027summary\u0027],\n      additionalProperties: false,\n    },\n    messages: [\n      {\n        role: \u0027user\u0027,\n        content: `Classify this inbound lead. Return only the requested JSON.\nRules:\n- high: urgent and concrete project.\n- normal: clear project without immediate urgency.\n- low: a concrete project or desired outcome with low urgency.\n- manualReview: true when the message does not state a clear task, desired outcome, or minimally actionable scope; also when data is ambiguous, contradictory, or insufficient.\n- Write summary in locale provided.\n- Do not decide whether to contact, reject, book, or send a message.\nLead:\n${JSON.stringify({\n  locale: $json.locale,\n  service: $json.service,\n  timeline: $json.timeline,\n  company: $json.company,\n  message: $json.message,\n})}`,\n      },\n    ],\n  };\n})()\n}}",
