                                                                                 "name":  "classification",
                                                                                 "value":  "={{ (() =\u003e {   try {     const value = JSON.parse($json.message?.content ?? \u0027\u0027);     const allowedPriorities = [\u0027high\u0027, \u0027normal\u0027, \u0027low\u0027];     const allowedKeys = [\u0027priority\u0027, \u0027manualReview\u0027, \u0027summary\u0027];      const valid =       value \u0026\u0026       typeof value === \u0027object\u0027 \u0026\u0026       !Array.isArray(value) \u0026\u0026       Object.keys(value).length === allowedKeys.length \u0026\u0026       Object.keys(value).every((key) =\u003e allowedKeys.includes(key)) \u0026\u0026       allowedPriorities.includes(value.priority) \u0026\u0026       typeof value.manualReview === \u0027boolean\u0027 \u0026\u0026       typeof value.summary === \u0027string\u0027 \u0026\u0026       value.summary.trim().length \u003e= 10 \u0026\u0026       value.summary.trim().length \u003c= 280;      if (!valid) {       return {         valid: false,         error: \u0027The model response does not match the classification schema.\u0027,       };     }      return {       valid: true,       priority: value.priority,       manualReview: value.manualReview,       summary: value.summary.trim(),     };   } catch {     return {       valid: false,       error: \u0027The model response is not valid JSON.\u0027,     };   } })() }}",
